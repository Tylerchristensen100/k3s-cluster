# Cluster credentials and keys - never commit
kubeconfig*
*.kubeconfig
k3s.yaml
*.key
*.pem
*.crt
*.age
.env
secrets/
*.secret.yaml
!*.sealed.yaml
# Sealed Secrets PUBLIC certificate is safe to commit (encrypt-only); the private key never leaves the cluster
!certs/sealed-secrets-pub.pem

# Personal Claude Code overrides (the shared .claude/settings.json IS committed)
.claude/settings.local.json
